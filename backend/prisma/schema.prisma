generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  PAID_LEAVE
  UNPAID_LEAVE
}

enum PayrollStatus {
  DRAFT
  FINALIZED
}

model Company {
  id String @id @default(uuid()) @db.Uuid
  name String
  code String @unique
  email String
  phone String
  address String
  logoUrl String?
  status CompanyStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  departments Department[]
  positions Position[]
  employees Employee[]
  meetings Meeting[]
  projects Project[]
  bulletins Bulletin[]
  notifications Notification[]
  issues Issue[]
  departmentPermissions DepartmentPermission[]
  attendances Attendance[]
  salaryProfiles SalaryProfile[]
  payrolls Payroll[]
  @@index([status])
}

model User {
  id String @id @default(uuid()) @db.Uuid
  companyId String? @db.Uuid
  email String @unique
  passwordHash String
  role Role
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee?
  refreshTokens RefreshToken[]
  organizedMeetings Meeting[] @relation("MeetingOrganizer")
  createdProjects Project[] @relation("ProjectCreator")
  createdBulletins Bulletin[] @relation("BulletinCreator")
  createdNotifications Notification[] @relation("NotificationCreator")
  createdIssues Issue[] @relation("IssueCreator")
  @@index([companyId])
  @@index([role])
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
}

model Department {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  code String
  name String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  positions Position[]
  permissions DepartmentPermission[]
  @@unique([companyId, code])
  @@index([companyId, name])
}

model Position {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  departmentId String @db.Uuid
  code String
  name String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees Employee[]
  @@unique([companyId, code])
  @@index([companyId, name])
  @@index([departmentId])
}

model Employee {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  userId String? @unique @db.Uuid
  employeeCode String
  fullName String
  email String
  phone String?
  address String?
  departmentId String? @db.Uuid
  positionId String? @db.Uuid
  hireDate DateTime?
  status EmployeeStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  assignedIssues Issue[] @relation("IssueAssignee")
  departmentPermission DepartmentPermission?
  attendances Attendance[]
  salaryProfile SalaryProfile?
  payrolls Payroll[]
  @@unique([companyId, employeeCode])
  @@index([companyId, fullName])
  @@index([departmentId])
  @@index([positionId])
}

model Attendance {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @db.Uuid
  workDate DateTime @db.Date
  checkIn DateTime?
  checkOut DateTime?
  status AttendanceStatus @default(PRESENT)
  workedMinutes Int @default(0)
  overtimeMinutes Int @default(0)
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@index([employeeId, workDate])
}

model SalaryProfile {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @unique @db.Uuid
  baseSalary Decimal @db.Decimal(18, 2)
  allowance Decimal @default(0) @db.Decimal(18, 2)
  overtimeHourlyRate Decimal @default(0) @db.Decimal(18, 2)
  standardWorkingDays Int @default(26)
  standardMinutesPerDay Int @default(480)
  currency String @default("VND")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([companyId])
}

model Payroll {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @db.Uuid
  year Int
  month Int
  baseSalary Decimal @db.Decimal(18, 2)
  allowance Decimal @db.Decimal(18, 2)
  overtimeHourlyRate Decimal @db.Decimal(18, 2)
  standardWorkingDays Int
  standardMinutesPerDay Int
  regularMinutes Int
  paidLeaveMinutes Int
  overtimeMinutes Int
  attendancePay Decimal @db.Decimal(18, 2)
  overtimePay Decimal @db.Decimal(18, 2)
  deductions Decimal @default(0) @db.Decimal(18, 2)
  netSalary Decimal @db.Decimal(18, 2)
  currency String @default("VND")
  status PayrollStatus @default(DRAFT)
  calculatedAt DateTime @default(now())
  finalizedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([companyId, employeeId, year, month])
  @@index([companyId, year, month])
  @@index([employeeId, year, month])
}

model DepartmentPermission {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  departmentId String @db.Uuid
  employeeId String @unique @db.Uuid
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  canAssignPosition Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([companyId, departmentId])
}

model Meeting {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  title String
  description String?
  organizerId String @db.Uuid
  location String?
  meetingUrl String?
  startAt DateTime
  endAt DateTime
  status MeetingStatus @default(SCHEDULED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizer User @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  @@index([companyId, startAt])
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  code String
  description String?
  createdById String @db.Uuid
  startDate DateTime?
  endDate DateTime?
  status ProjectStatus @default(PLANNING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User @relation("ProjectCreator", fields: [createdById], references: [id])
  issues Issue[]
  @@unique([companyId, code])
  @@index([companyId, name])
}

model Issue {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  projectId String @db.Uuid
  assigneeId String? @db.Uuid
  createdById String @db.Uuid
  title String
  description String?
  priority IssuePriority @default(MEDIUM)
  status IssueStatus @default(OPEN)
  dueDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee Employee? @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User @relation("IssueCreator", fields: [createdById], references: [id])
  @@index([companyId, status])
  @@index([projectId])
  @@index([assigneeId])
}

model Bulletin {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  title String
  content String
  createdById String @db.Uuid
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User @relation("BulletinCreator", fields: [createdById], references: [id])
  @@index([companyId, publishedAt])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  title String
  message String
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User @relation("NotificationCreator", fields: [createdById], references: [id])
  @@index([companyId, createdAt])
}
