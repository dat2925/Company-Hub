generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  PAID_LEAVE
  UNPAID_LEAVE
}

enum PayrollStatus {
  DRAFT
  FINALIZED
}

enum SkillSource {
  SELF_DECLARED
  MANAGER_VERIFIED
  PROJECT_EVIDENCE
  CERTIFICATION
}

enum TalentOpportunityType {
  PROJECT_ROLE
  INTERNAL_POSITION
  SHORT_TERM_MISSION
}

enum TalentOpportunityStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum OpportunityApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ImpactEntryType {
  DELIVERY
  IMPROVEMENT
  CUSTOMER_IMPACT
  TEAM_SUPPORT
  LEARNING
  LEADERSHIP
  OTHER
}

enum ImpactVisibility {
  PRIVATE
  MANAGER
  COMPANY
}

enum ImpactReportPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum ImpactReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum EmployeeGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ArcadeChallengeType {
  TRIVIA
  POLL
  CAPTION
  GUESS_COLLEAGUE
}

enum ArcadeContentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ArcadeSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ArcadeRoomStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

enum ArcadeRoomMode {
  QUICK_QUIZ
  ICEBREAKER
}

enum ChatConversationType {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChatMessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum ChatTheme {
  DEFAULT
  OCEAN
  FOREST
  SUNSET
  LAVENDER
  MIDNIGHT
}

model Company {
  id String @id @default(uuid()) @db.Uuid
  name String
  code String @unique
  email String
  phone String
  address String
  logoUrl String?
  status CompanyStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  departments Department[]
  positions Position[]
  employees Employee[]
  meetings Meeting[]
  projects Project[]
  bulletins Bulletin[]
  notifications Notification[]
  issues Issue[]
  departmentPermissions DepartmentPermission[]
  attendances Attendance[]
  salaryProfiles SalaryProfile[]
  payrolls Payroll[]
  shifts Shift[]
  shiftAssignments ShiftAssignment[]
  skills Skill[]
  employeeSkills EmployeeSkill[]
  projectSkillRequirements ProjectSkillRequirement[]
  talentOpportunities TalentOpportunity[]
  opportunitySkillRequirements OpportunitySkillRequirement[]
  opportunityApplications OpportunityApplication[]
  impactEntries ImpactEntry[]
  impactReports ImpactReport[]
  employeeGoals EmployeeGoal[]
  recognitions Recognition[]
  arcadeChallenges ArcadeChallenge[]
  arcadePlays ArcadePlay[]
  arcadeMissions ArcadeMission[]
  arcadeMissionSubmissions ArcadeMissionSubmission[]
  arcadeRooms ArcadeRoom[]
  chatConversations ChatConversation[]
  chatMembers ChatMember[]
  chatMessages ChatMessage[]
  chatReactions ChatReaction[]
  @@index([status])
}

model User {
  id String @id @default(uuid()) @db.Uuid
  companyId String? @db.Uuid
  email String @unique
  passwordHash String
  role Role
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee?
  refreshTokens RefreshToken[]
  organizedMeetings Meeting[] @relation("MeetingOrganizer")
  createdProjects Project[] @relation("ProjectCreator")
  createdBulletins Bulletin[] @relation("BulletinCreator")
  createdNotifications Notification[] @relation("NotificationCreator")
  createdIssues Issue[] @relation("IssueCreator")
  createdTalentOpportunities TalentOpportunity[] @relation("TalentOpportunityCreator")
  reviewedImpactReports ImpactReport[] @relation("ImpactReportReviewer")
  createdArcadeChallenges ArcadeChallenge[] @relation("ArcadeChallengeCreator")
  createdArcadeMissions ArcadeMission[] @relation("ArcadeMissionCreator")
  @@index([companyId])
  @@index([role])
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
}

model Department {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  code String
  name String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  positions Position[]
  permissions DepartmentPermission[]
  @@unique([companyId, code])
  @@index([companyId, name])
}

model Position {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  departmentId String @db.Uuid
  code String
  name String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees Employee[]
  @@unique([companyId, code])
  @@index([companyId, name])
  @@index([departmentId])
}

model Employee {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  userId String? @unique @db.Uuid
  employeeCode String
  fullName String
  email String
  phone String?
  address String?
  departmentId String? @db.Uuid
  positionId String? @db.Uuid
  hireDate DateTime?
  status EmployeeStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  assignedIssues Issue[] @relation("IssueAssignee")
  departmentPermission DepartmentPermission?
  attendances Attendance[]
  salaryProfile SalaryProfile?
  payrolls Payroll[]
  shiftAssignments ShiftAssignment[]
  skills EmployeeSkill[]
  opportunityApplications OpportunityApplication[]
  impactEntries ImpactEntry[]
  impactReports ImpactReport[]
  goals EmployeeGoal[]
  recognitionsGiven Recognition[] @relation("RecognitionSender")
  recognitionsReceived Recognition[] @relation("RecognitionReceiver")
  arcadePlays ArcadePlay[]
  arcadeMissionSubmissions ArcadeMissionSubmission[]
  arcadeRoomMemberships ArcadeRoomMember[]
  chatConversationsCreated ChatConversation[] @relation("ChatConversationCreator")
  chatMemberships ChatMember[]
  sentChatMessages ChatMessage[] @relation("ChatMessageSender")
  chatReactions ChatReaction[]
  @@unique([companyId, employeeCode])
  @@index([companyId, fullName])
  @@index([departmentId])
  @@index([positionId])
}

model Attendance {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @db.Uuid
  shiftAssignmentId String? @unique @db.Uuid
  workDate DateTime @db.Date
  checkIn DateTime?
  checkOut DateTime?
  status AttendanceStatus @default(PRESENT)
  workedMinutes Int @default(0)
  overtimeMinutes Int @default(0)
  regularMinutes Int @default(0)
  scheduledMinutes Int @default(0)
  earlyArrivalMinutes Int @default(0)
  lateArrivalMinutes Int @default(0)
  earlyLeaveMinutes Int @default(0)
  lateLeaveMinutes Int @default(0)
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftAssignment ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id], onDelete: SetNull)
  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@index([employeeId, workDate])
}

model Shift {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  code String
  name String
  startTime String
  endTime String
  breakMinutes Int @default(0)
  lateGraceMinutes Int @default(0)
  earlyLeaveGraceMinutes Int @default(0)
  overtimeAllowed Boolean @default(true)
  overtimeThresholdMinutes Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]
  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model ShiftAssignment {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @db.Uuid
  shiftId String @db.Uuid
  workDate DateTime @db.Date
  scheduledStartAt DateTime
  scheduledEndAt DateTime
  breakMinutes Int
  lateGraceMinutes Int
  earlyLeaveGraceMinutes Int
  overtimeAllowed Boolean
  overtimeThresholdMinutes Int
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  attendance Attendance?
  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@index([employeeId, workDate])
  @@index([shiftId])
}

model SalaryProfile {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @unique @db.Uuid
  baseSalary Decimal @db.Decimal(18, 2)
  allowance Decimal @default(0) @db.Decimal(18, 2)
  overtimeHourlyRate Decimal @default(0) @db.Decimal(18, 2)
  standardWorkingDays Int @default(26)
  standardMinutesPerDay Int @default(480)
  currency String @default("VND")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([companyId])
}

model Payroll {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @db.Uuid
  year Int
  month Int
  baseSalary Decimal @db.Decimal(18, 2)
  allowance Decimal @db.Decimal(18, 2)
  overtimeHourlyRate Decimal @db.Decimal(18, 2)
  standardWorkingDays Int
  standardMinutesPerDay Int
  regularMinutes Int
  paidLeaveMinutes Int
  overtimeMinutes Int
  attendancePay Decimal @db.Decimal(18, 2)
  overtimePay Decimal @db.Decimal(18, 2)
  deductions Decimal @default(0) @db.Decimal(18, 2)
  netSalary Decimal @db.Decimal(18, 2)
  currency String @default("VND")
  status PayrollStatus @default(DRAFT)
  calculatedAt DateTime @default(now())
  finalizedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([companyId, employeeId, year, month])
  @@index([companyId, year, month])
  @@index([employeeId, year, month])
}

model DepartmentPermission {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  departmentId String @db.Uuid
  employeeId String @unique @db.Uuid
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  canAssignPosition Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([companyId, departmentId])
}

model Meeting {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  title String
  description String?
  organizerId String @db.Uuid
  location String?
  meetingUrl String?
  startAt DateTime
  endAt DateTime
  status MeetingStatus @default(SCHEDULED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizer User @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  @@index([companyId, startAt])
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  code String
  description String?
  createdById String @db.Uuid
  startDate DateTime?
  endDate DateTime?
  status ProjectStatus @default(PLANNING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User @relation("ProjectCreator", fields: [createdById], references: [id])
  issues Issue[]
  skillRequirements ProjectSkillRequirement[]
  talentOpportunities TalentOpportunity[]
  impactEntries ImpactEntry[]
  @@unique([companyId, code])
  @@index([companyId, name])
}

model Skill {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  code String
  name String
  category String?
  description String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeSkills EmployeeSkill[]
  projectRequirements ProjectSkillRequirement[]
  opportunityRequirements OpportunitySkillRequirement[]
  recognitions Recognition[]
  @@unique([companyId, code])
  @@index([companyId, name])
  @@index([companyId, category])
}

model EmployeeSkill {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @db.Uuid
  skillId String @db.Uuid
  level Int
  yearsExperience Int @default(0)
  source SkillSource @default(SELF_DECLARED)
  evidence String?
  verifiedAt DateTime?
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@unique([employeeId, skillId])
  @@index([companyId, skillId, level])
  @@index([companyId, employeeId])
}

model ProjectSkillRequirement {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  projectId String @db.Uuid
  skillId String @db.Uuid
  minimumLevel Int @default(1)
  weight Int @default(1)
  isRequired Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@unique([projectId, skillId])
  @@index([companyId, projectId])
  @@index([companyId, skillId])
}

model TalentOpportunity {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  projectId String? @db.Uuid
  createdById String @db.Uuid
  title String
  description String?
  type TalentOpportunityType
  status TalentOpportunityStatus @default(DRAFT)
  openings Int @default(1)
  startDate DateTime? @db.Date
  endDate DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User @relation("TalentOpportunityCreator", fields: [createdById], references: [id])
  requirements OpportunitySkillRequirement[]
  applications OpportunityApplication[]
  @@index([companyId, status, startDate])
  @@index([projectId])
}

model OpportunitySkillRequirement {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  opportunityId String @db.Uuid
  skillId String @db.Uuid
  minimumLevel Int @default(1)
  weight Int @default(1)
  isRequired Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity TalentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@unique([opportunityId, skillId])
  @@index([companyId, opportunityId])
  @@index([companyId, skillId])
}

model OpportunityApplication {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  opportunityId String @db.Uuid
  employeeId String @db.Uuid
  status OpportunityApplicationStatus @default(PENDING)
  message String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity TalentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([opportunityId, employeeId])
  @@index([companyId, employeeId, status])
  @@index([companyId, opportunityId, status])
}

model Issue {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  projectId String @db.Uuid
  assigneeId String? @db.Uuid
  createdById String @db.Uuid
  title String
  description String?
  priority IssuePriority @default(MEDIUM)
  status IssueStatus @default(OPEN)
  dueDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee Employee? @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User @relation("IssueCreator", fields: [createdById], references: [id])
  impactEntries ImpactEntry[]
  @@index([companyId, status])
  @@index([projectId])
  @@index([assigneeId])
}

model ImpactEntry {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @db.Uuid
  projectId String? @db.Uuid
  sourceIssueId String? @db.Uuid
  type ImpactEntryType
  title String
  description String?
  occurredOn DateTime @db.Date
  metrics Json?
  visibility ImpactVisibility @default(MANAGER)
  isHighlighted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceIssue Issue? @relation(fields: [sourceIssueId], references: [id], onDelete: SetNull)
  @@unique([employeeId, sourceIssueId])
  @@index([companyId, employeeId, occurredOn])
  @@index([companyId, visibility, occurredOn])
  @@index([projectId])
}

model ImpactReport {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @db.Uuid
  reviewerId String? @db.Uuid
  period ImpactReportPeriod
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  status ImpactReportStatus @default(DRAFT)
  snapshot Json
  selfReflection String?
  managerComment String?
  submittedAt DateTime?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ImpactReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  @@index([companyId, employeeId, periodStart, periodEnd])
  @@index([companyId, status, submittedAt])
}

model EmployeeGoal {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  employeeId String @db.Uuid
  title String
  description String?
  progress Int @default(0)
  status EmployeeGoalStatus @default(ACTIVE)
  startDate DateTime @db.Date
  targetDate DateTime? @db.Date
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([companyId, employeeId, status])
  @@index([companyId, targetDate])
}

model Recognition {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  senderEmployeeId String @db.Uuid
  receiverEmployeeId String @db.Uuid
  skillId String? @db.Uuid
  message String
  visibility ImpactVisibility @default(COMPANY)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sender Employee @relation("RecognitionSender", fields: [senderEmployeeId], references: [id], onDelete: Cascade)
  receiver Employee @relation("RecognitionReceiver", fields: [receiverEmployeeId], references: [id], onDelete: Cascade)
  skill Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  @@index([companyId, receiverEmployeeId, createdAt])
  @@index([companyId, visibility, createdAt])
  @@index([senderEmployeeId])
}

model ArcadeChallenge {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  createdById String @db.Uuid
  title String
  description String?
  type ArcadeChallengeType
  question String
  options Json?
  correctAnswer String?
  points Int @default(10)
  status ArcadeContentStatus @default(DRAFT)
  startsAt DateTime
  endsAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User @relation("ArcadeChallengeCreator", fields: [createdById], references: [id])
  plays ArcadePlay[]
  @@index([companyId, status, startsAt, endsAt])
  @@index([companyId, type])
}

model ArcadePlay {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  challengeId String @db.Uuid
  employeeId String @db.Uuid
  answer String
  isCorrect Boolean?
  pointsAwarded Int @default(0)
  durationMs Int?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  challenge ArcadeChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([challengeId, employeeId])
  @@index([companyId, createdAt])
  @@index([employeeId, createdAt])
}

model ArcadeMission {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  createdById String @db.Uuid
  title String
  description String?
  points Int @default(20)
  requiresProof Boolean @default(true)
  status ArcadeContentStatus @default(DRAFT)
  startsAt DateTime
  endsAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User @relation("ArcadeMissionCreator", fields: [createdById], references: [id])
  submissions ArcadeMissionSubmission[]
  @@index([companyId, status, startsAt, endsAt])
}

model ArcadeMissionSubmission {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  missionId String @db.Uuid
  employeeId String @db.Uuid
  proofText String?
  proofUrl String?
  status ArcadeSubmissionStatus @default(PENDING)
